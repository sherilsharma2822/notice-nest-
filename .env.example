# Copy this file to ".env" and fill in what you need. Never commit ".env" to GitHub.

# Used to sign login cookies. Put any long random text here.
SECRET_KEY=change-me-to-something-long-and-random

# ---- AI extraction (optional) ----------------------------------------------
# none   = basic mode (regex only, works with no key)
# gemini = Google Gemini API (free tier available in Google AI Studio)
# groq   = Groq API (free tier available)
LLM_PROVIDER=none

GEMINI_API_KEY=
# Model names change over time. Check Google AI Studio for a current free model.
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
# Check the Groq console for currently available free models.
GROQ_MODEL=openai/gpt-oss-120b

# ---- Reminders (optional) ----------------------------------------------------
# Telegram: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Email through SMTP (for Gmail use an "App Password", not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Scraping politeness -----------------------------------------------------
# Your contact email goes in the bot's User-Agent so site admins can reach you.
USER_AGENT_CONTACT=your-email@example.com
REQUEST_DELAY_SECONDS=2
